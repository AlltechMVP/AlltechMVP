{
  "type": "module",
  "name": "alltech-mvp",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "analyze": "vite build && echo 'Bundle analysis available in dist/stats.html'",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css}\"",
    "preview": "vite preview",
    "seed:supabase": "node scripts/seed-supabase.js",
    "prepare": "husky",
    "test:e2e": "PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS=true playwright test",
    "test:e2e:headed": "PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS=true playwright test --headed",
    "test:e2e:update": "PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS=true playwright test --update-snapshots"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@playwright/test": "^1.56.0",
    "@supabase/supabase-js": "^2.49.4",
    "@types/node": "^22.15.11",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.20",
    "child_process": "^1.0.2",
    "date-fns": "^4.1.0",
    "fs": "^0.0.1-security",
    "html2canvas": "^1.4.1",
    "husky": "^9.1.7",
    "jspdf": "^3.0.1",
    "lint-staged": "^15.5.2",
    "postcss": "^8.4.47",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.30.0",
    "recharts": "^2.15.3",
    "rollup-plugin-visualizer": "^6.0.4",
    "serve": "^14.2.4",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "eslint": "^9.12.0",
    "eslint-plugin-react": "^7.37.0",
    "prettier": "^3.3.3",
    "supabase": "^3.1.0"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,css}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
